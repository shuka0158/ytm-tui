#!/usr/bin/env bash
# Launcher for ytm-tui. Uses the project-local virtualenv.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="$HERE/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
    echo "Virtualenv missing. Run:  python3 -m venv $HERE/.venv && $HERE/.venv/bin/pip install -r $HERE/requirements.txt" >&2
    exit 1
fi

cd "$HERE"
exec "$PY" -m ytmtui "$@"
