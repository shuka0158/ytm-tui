Screen {
    background: $surface;
    layout: vertical;
}

#main {
    height: 1fr;
}

.pane-title {
    background: $panel;
    color: $accent;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

#tracks-header {
    align-horizontal: right;
}

#tracks-header > #tracks-title {
    width: 1fr;
    background: transparent;
    padding: 0;
}

#import-folder-btn {
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: $accent-darken-2;
    color: $text;
    text-style: none;
}

#import-folder-btn:hover {
    background: $accent;
}

#sidebar {
    width: 32;
    border-right: solid $primary-darken-2;
}

#playlists {
    height: 1fr;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#playlists > ListItem {
    padding: 0 1;
}

#playlists > ListItem.--highlight {
    background: $accent-darken-2;
}

#content {
    width: 1fr;
}

#download-status {
    height: auto;
    max-height: 4;
    background: $panel;
    color: $warning;
    padding: 0 1;
}

#tracks {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#tracks > .datatable--cursor {
    background: $accent-darken-1;
    color: $text;
    text-style: bold;
}

#now {
    height: 9;
    background: $panel;
    border-top: solid $primary-darken-2;
    padding: 0 1;
}

#art {
    width: 16;
    height: 8;
    margin-right: 2;
}

#np {
    width: 1fr;
    height: 8;
    padding-top: 1;
}

#disc {
    width: 12;
    height: 8;
    content-align: center bottom;
    dock: right;
}

#viz {
    width: 24;
    height: 8;
    content-align: center bottom;
    dock: right;
}

#np-title {
    height: 1;
    color: $text;
}

#np-artist {
    height: 1;
}

#np-bar {
    height: 1;
    margin-top: 1;
}

#np-status {
    height: 1;
    margin-top: 1;
}

SearchScreen, DownloadScreen, NewPlaylistScreen, ImportFolderScreen, QueueScreen {
    align: center middle;
    background: $surface 60%;
}

#search-box {
    width: 68;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

HelpScreen {
    align: center middle;
    background: $surface 70%;
}

#help-box {
    width: 66;
    height: auto;
    max-height: 92%;
    scrollbar-size-vertical: 1;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

ThemeScreen, PlaylistPickScreen, SleepScreen {
    align: center middle;
    background: $surface 70%;
}

#theme-box {
    width: 44;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

#theme-list {
    height: auto;
    max-height: 18;
    margin: 1 0;
    background: $panel;
    scrollbar-size-vertical: 1;
}

#theme-list > ListItem {
    padding: 0 1;
}

#theme-list > ListItem.--highlight {
    background: $accent-darken-2;
}

LyricsScreen {
    align: center middle;
    background: $surface 70%;
}

#lyrics-box {
    width: 70%;
    height: 70%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

#lyrics-heading {
    height: auto;
    color: $accent;
    padding-bottom: 1;
    border-bottom: solid $primary-darken-2;
}

#lyrics-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
    margin-top: 1;
}

#lyrics-body {
    width: 1fr;
    height: auto;
}

#search-filters {
    height: auto;
    margin: 1 0;
}

#queue-box {
    width: 90;
    max-width: 100%;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

#queue-heading {
    height: 1;
    color: $accent;
    margin-bottom: 1;
}

#queue-table {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#queue-table > .datatable--cursor {
    background: $accent-darken-1;
    color: $text;
    text-style: bold;
}
